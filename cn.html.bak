<!-- 符合性判定演示 -->
<section style="padding:60px 0;background:var(--card);text-align:center;">
<div class="container">
<h3 style="font-size:22px;font-weight:800;color:var(--moss-light);margin-bottom:10px;">符合性判定演示（标准数字化核心能力）</h3>
<p style="color:var(--ink-muted);margin-bottom:26px;">手动输入 7 项农艺指标检测值，系统自动与 SW-IND-001~007 限值比对，判定 A/B/C 等级。</p>
<div class="compliance-demo">
<div class="form-grid">
<div class="field">
<label>孔隙率 (%)</label>
<input type="text" id="i1" value="88">
<div class="unit">限值 85–95</div>
</div>
<div class="field">
<label>保水性 WHC (%)</label>
<input type="text" id="i2" value="65">
<div class="unit">限值 ≥60</div>
</div>
<div class="field">
<label>EC (mS/cm)</label>
<input type="text" id="i3" value="1.2">
<div class="unit">限值 ≤1.5</div>
</div>
<div class="field">
<label>pH</label>
<input type="text" id="i4" value="6.0">
<div class="unit">限值 5.5–6.5</div>
</div>
<div class="field">
<label>纤维直径 (μm)</label>
<input type="text" id="i5" value="5.5">
<div class="unit">限值 4–8</div>
</div>
<div class="field">
<label>渣球含量 (%)</label>
<input type="text" id="i6" value="3.0">
<div class="unit">限值 ≤5</div>
</div>
<div class="field">
<label>有机杂质 (%)</label>
<input type="text" id="i7" value="0.05">
<div class="unit">限值 ≤0.1</div>
</div>
</div>
<button class="btn-check" onclick="runCompliance()">执行符合性判定</button>
<div class="compliance-result" id="complianceResult">
<div class="grade" id="gradeVal">A</div>
<div class="desc" id="gradeDesc">合格 — 全部指标在限值内，可用于水稻育秧。</div>
<div class="items" id="gradeItems"></div>
</div>
</div>
<p style="font-size:12px;color:#94a3b8;margin-top:16px;">⚠️ 指标限值为工程示意值，最终以中国农科院实验室联合标定与正式标准为准。本页不刊登任何价格、毛利或 ROI 数值。</p>
</div>
</section>

<script>
function openVerifyModal(){
document.getElementById('verifyModal').classList.add('open');
document.getElementById('batchInput').value='';
document.getElementById('verifyResult').style.display='none';
document.body.style.overflow='hidden';
}
function closeVerifyModal(){
document.getElementById('verifyModal').classList.remove('open');
document.body.style.overflow='';
}
function verifyBatch(){
const input=document.getElementById('batchInput').value.trim();
const result=document.getElementById('verifyResult');
const val=document.getElementById('verifyVal');
if(!input){alert('请输入批次号');return;}
result.style.display='block';
result.className='verify-result ok';
val.textContent='A 等级 — 检测数据全部达标（演示数据）';
result.querySelector('.small').textContent='批次号：'+input+' · 生产日期：2025-11-05 · 产线：A 线 · 检测机构：第三方 CMA 实验室（演示）';
}
function runCompliance(){
const ids=['i1','i2','i3','i4','i5','i6','i7'];
const names=['孔隙率','保水性 WHC','EC','pH','纤维直径','渣球含量','有机杂质'];
const limits=[{lo:85,hi:95},{lo:60,hi:null},{lo:null,hi:1.5},{lo:5.5,hi:6.5},{lo:4,hi:8},{lo:null,hi:5},{lo:null,hi:0.1}];
let grade='A';const items=[];let allOk=true,minor=0;
ids.forEach((id,k)=>{
const v=parseFloat(document.getElementById(id).value);
let status='正常';
if((limits[k].lo!==null&&v<limits[k].lo)||(limits[k].hi!==null&&v>limits[k].hi)){status='超标';allOk=false;minor++;}
items.push(`<div style="margin:4px 0;"><strong>${names[k]}</strong>：检测值 ${v}，限值 ${limits[k].lo!==null?limits[k].lo:'—'} ~ ${limits[k].hi!==null?limits[k].hi:'—'}，<span style="color:${status==='正常'?'#4FC38A':'#c0392b'}">${status}</span></div>`);
});
if(allOk){grade='A';}else if(minor<=2){grade='B';}else{grade='C';}
const res=document.getElementById('complianceResult');
res.style.display='block';
res.className='compliance-result '+(grade==='A'?'A':grade==='B'?'B':'C');
document.getElementById('gradeVal').textContent=grade;
const descMap={'A':'合格 — 全部指标在限值内，可用于水稻育秧。','B':'可使用，建议改进 — 单项轻微超标。','C':'不合格 — 多项或关键指标超标，不建议用于水稻育秧。'};
document.getElementById('gradeDesc').textContent=descMap[grade];
document.getElementById('gradeItems').innerHTML=items.join('');
}
// Close modal when clicking background
document.getElementById('verifyModal').addEventListener('click',function(e){if(e.target===this)closeVerifyModal();});
</script>
</body>
</html>